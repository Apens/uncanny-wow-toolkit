{
    "name": "uncanny-wow/toolkit",
    "description": "A modern PHP toolkit for building applications around World of Warcraft data.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Uncanny-WoW Team"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "halaxa/json-machine": "^1.2",
        "psr/cache": "^2.0 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/http-client": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "UncannyWoW\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UncannyWoW\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
